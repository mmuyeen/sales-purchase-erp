# Supabase PostgreSQL connection string.
# Use the "Connection pooling" (transaction mode, port 6543) URI from
# Supabase → Project Settings → Database → Connection string.
# Example shape (replace with your actual values):
# postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Port used by the local Express dev server (backend/devServer.js).
# Not used on Vercel (serverless functions do not listen on a port).
PORT=4000

# Company details shown on the printable invoice.
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_GST_NUMBER=

# Company's GST state, used to determine CGST+SGST (intra-state) vs IGST
# (inter-state) on invoices/orders. COMPANY_STATE must exactly match one of
# the hard-coded Indian state names (see shared/constants.js INDIAN_STATES).
# COMPANY_STATE_CODE is optional — if omitted, the code is derived from
# COMPANY_GST_NUMBER's first two digits, or otherwise looked up from
# COMPANY_STATE. Set COMPANY_STATE_CODE explicitly only to override that.
COMPANY_STATE=
COMPANY_STATE_CODE=
