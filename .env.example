# Supabase PostgreSQL connection string.
# Use the "Connection pooling" (transaction mode, port 6543) URI from
# Supabase → Project Settings → Database → Connection string.
# Example shape (replace with your actual values):
# postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Port used by the local Express dev server (backend/devServer.js).
# Not used on Vercel (serverless functions do not listen on a port).
PORT=4000

# Secret used to sign/verify authentication JWTs (see backend/middleware/auth.js).
# Required. Generate a long random value, e.g.: openssl rand -base64 48
# Never commit the real value — this file only holds a placeholder.
JWT_SECRET=

# NOTE: Forgot Password is intentionally a simple email-lookup + new-password
# flow (see backend/controllers/authController.js) — no reset link, token,
# OTP, or outgoing email is involved, so no APP_URL/EMAIL_FROM/SMTP_* config
# is required for it.

# NOTE: This application is multi-tenant. Company information (name,
# address, GST number, state, state code) is NOT configured via environment
# variables anymore — each vendor/company registers their own account and
# manages their own company profile from the Company Settings page. The
# COMPANY_NAME / COMPANY_ADDRESS / COMPANY_GST_NUMBER / COMPANY_STATE /
# COMPANY_STATE_CODE variables that used to exist here have been removed;
# production runtime code no longer reads them.
